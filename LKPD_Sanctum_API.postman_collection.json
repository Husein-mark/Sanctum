{
    "info": {
        "_postman_id": "lkpd-sanctum-api",
        "name": "LKPD Sanctum API",
        "description": "Collection untuk menguji API Laravel Sanctum - LKPD RPL Kelas XI\n\nInstruksi:\n1. Jalankan 'Register Akun A' terlebih dahulu\n2. Jalankan 'Login Akun A' - token akan tersimpan otomatis di variable\n3. Gunakan endpoint yang memerlukan token (profil, catatan, logout)\n\nSemua request menggunakan:\n- Accept: application/json\n- POST: Content-Type: application/json\n- Token tersimpan di variable {{token}}",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8000/api",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "1. Register",
            "item": [
                {
                    "name": "Register Akun A (valid)",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Akun A\",\n    \"email\": \"a@test.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/register",
                            "host": ["{{base_url}}"],
                            "path": ["register"]
                        }
                    }
                },
                {
                    "name": "Register Akun B (valid)",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Akun B\",\n    \"email\": \"b@test.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/register",
                            "host": ["{{base_url}}"],
                            "path": ["register"]
                        }
                    }
                },
                {
                    "name": "Register Email Duplikat",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Akun A Lagi\",\n    \"email\": \"a@test.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/register",
                            "host": ["{{base_url}}"],
                            "path": ["register"]
                        }
                    }
                },
                {
                    "name": "Register Konfirmasi Tidak Cocok",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Test\",\n    \"email\": \"test@test.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"berbeda456\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/register",
                            "host": ["{{base_url}}"],
                            "path": ["register"]
                        }
                    }
                }
            ]
        },
        {
            "name": "2. Login",
            "item": [
                {
                    "name": "Login Akun A (benar)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const resp = pm.response.json();",
                                    "    pm.collectionVariables.set('token', resp.access_token);",
                                    "    console.log('Token tersimpan:', resp.access_token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"a@test.com\",\n    \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/login",
                            "host": ["{{base_url}}"],
                            "path": ["login"]
                        }
                    }
                },
                {
                    "name": "Login Password Salah",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"a@test.com\",\n    \"password\": \"passwordsalah\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/login",
                            "host": ["{{base_url}}"],
                            "path": ["login"]
                        }
                    }
                }
            ]
        },
        {
            "name": "3. Profil",
            "item": [
                {
                    "name": "Profil Tanpa Token",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{base_url}}/profil",
                            "host": ["{{base_url}}"],
                            "path": ["profil"]
                        }
                    }
                },
                {
                    "name": "Profil Token Acak",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer tokenacakyangtidakvalid123" }
                        ],
                        "url": {
                            "raw": "{{base_url}}/profil",
                            "host": ["{{base_url}}"],
                            "path": ["profil"]
                        }
                    }
                },
                {
                    "name": "Profil Token Valid",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{token}}" }
                        ],
                        "url": {
                            "raw": "{{base_url}}/profil",
                            "host": ["{{base_url}}"],
                            "path": ["profil"]
                        }
                    }
                }
            ]
        },
        {
            "name": "4. Catatan",
            "item": [
                {
                    "name": "Tambah Catatan Valid (Akun A)",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{token}}" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"judul\": \"Catatan Pertama A\",\n    \"isi\": \"Ini adalah catatan milik Akun A.\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/catatan",
                            "host": ["{{base_url}}"],
                            "path": ["catatan"]
                        }
                    }
                },
                {
                    "name": "Tambah Catatan Judul Kosong (invalid)",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{token}}" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"judul\": \"\",\n    \"isi\": \"Isi ada tapi judul kosong.\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/catatan",
                            "host": ["{{base_url}}"],
                            "path": ["catatan"]
                        }
                    }
                },
                {
                    "name": "Lihat Catatan Akun A",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{token}}" }
                        ],
                        "url": {
                            "raw": "{{base_url}}/catatan",
                            "host": ["{{base_url}}"],
                            "path": ["catatan"]
                        }
                    }
                }
            ]
        },
        {
            "name": "5. Multi Akun",
            "item": [
                {
                    "name": "Login Akun B",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const resp = pm.response.json();",
                                    "    pm.collectionVariables.set('token', resp.access_token);",
                                    "    console.log('Token B tersimpan:', resp.access_token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"b@test.com\",\n    \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/login",
                            "host": ["{{base_url}}"],
                            "path": ["login"]
                        }
                    }
                },
                {
                    "name": "Lihat Catatan (sebagai Akun B - tidak dapat catatan A)",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{token}}" }
                        ],
                        "url": {
                            "raw": "{{base_url}}/catatan",
                            "host": ["{{base_url}}"],
                            "path": ["catatan"]
                        }
                    }
                }
            ]
        },
        {
            "name": "6. Logout",
            "item": [
                {
                    "name": "Logout (Token Aktif)",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{token}}" }
                        ],
                        "url": {
                            "raw": "{{base_url}}/logout",
                            "host": ["{{base_url}}"],
                            "path": ["logout"]
                        }
                    }
                },
                {
                    "name": "Gunakan Token Setelah Logout (harusnya 401)",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{token}}" }
                        ],
                        "url": {
                            "raw": "{{base_url}}/profil",
                            "host": ["{{base_url}}"],
                            "path": ["profil"]
                        }
                    }
                }
            ]
        }
    ]
}
